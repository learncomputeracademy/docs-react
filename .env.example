# Copy to .env.local and fill in. .env.local is git-ignored; this file is not.
# NEVER put real secrets in this file.

# Cloudinary — account "docslca". Values in 1Password / .env.local.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Supabase — project ref ipurerfngdvoxbypfdzt. Values in .env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# ⚠️ bypasses all RLS — server-side only, never NEXT_PUBLIC_*
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 — overflow storage for any file ≥10MB (Cloudinary free-tier cap).
# Account: learncomputerseo@gmail.com. Bucket: lca-docs-files.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
# ⚠️ server-side only, never NEXT_PUBLIC_*
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET_NAME=
# Public bucket URL — safe as NEXT_PUBLIC_, only the bucket is public, not the account
NEXT_PUBLIC_R2_PUBLIC_URL=

# Revalidation webhook (Stage 6) — openssl rand -hex 32
REVALIDATE_SECRET=

# Contact form (Stage 8)
RESEND_API_KEY=
CONTACT_TO_EMAIL=

# Site
NEXT_PUBLIC_SITE_URL=https://docs.learncomputer.in
